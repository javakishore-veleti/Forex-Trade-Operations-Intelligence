      },
      "id": "genome-node-005",
      "name": "Find Change Consumers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, 440]
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "You are a service architecture analyst for an FX operations platform. Given: (1) service profile, (2) dependency map, (3) fragility score with factors, (4) change consumers — produce a comprehensive genome report. For FRAGILITY queries: explain why the score is what it is, identify the primary risk drivers, recommend safeguards. For PROFILE queries: summarize the service's role and characteristics. For CHANGE_IMPACT queries: describe who is affected and how. Output JSON: { \"service\": \"\", \"profile\": {}, \"fragilityScore\": 0, \"fragilityDrivers\": [], \"consumers\": [], \"recommendations\": [], \"narrative\": \"\" }.",
          "temperature": 0.1
        },
        "promptType": "define",
        "text": "=Service genome analysis for '{{ $('Webhook Trigger').item.json.body.service }}' (query type: {{ $('Webhook Trigger').item.json.body.queryType }}):\n\n- Service profile: {{ JSON.stringify($('Get Service Profile').item.json) }}\n- Dependencies: {{ JSON.stringify($('Get Dependencies').item.json) }}\n- Fragility prediction: {{ JSON.stringify($('Predict Fragility').item.json) }}\n- Change consumers: {{ JSON.stringify($('Find Change Consumers').item.json) }}\n\nProduce a comprehensive genome report."
      },
      "id": "genome-node-006",
      "name": "Genome Analyzer",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [1040, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ agent: 'service-genome', service: $('Webhook Trigger').item.json.body.service, queryType: $('Webhook Trigger').item.json.body.queryType, correlationId: $('Webhook Trigger').item.json.body.correlationId, profile: $('Get Service Profile').item.json, fragilityPrediction: $('Predict Fragility').item.json, genomeAnalysis: $json.output, timestamp: new Date().toISOString() }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "genome-node-007",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1320, 300]
    }
