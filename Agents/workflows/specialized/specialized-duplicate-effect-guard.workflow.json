      ]
    },
    "Approval Handler": {
      "main": [
        [{ "node": "Execute Reversal", "type": "main", "index": 0 }],
        [{ "node": "Hold", "type": "main", "index": 0 }]
      ]
    },
    "Execute Reversal": {
      "main": [
        [{ "node": "Webhook Response", "type": "main", "index": 0 }]
      ]
    },
    "Hold": {
      "main": [
        [{ "node": "Webhook Response", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "staticData": null,
  "tags": [
