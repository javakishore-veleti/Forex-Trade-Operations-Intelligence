      "id": "rule-cov-005",
      "name": "Simulate Gap",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 320]
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "You are a rule coverage analyst for an FX platform. Given coverage matrix, fallback firing rates, uncovered pairs, and gap simulation results — explain: (1) which pairs are at risk, (2) what business impact the gap creates (mispricing, unintended exposure), (3) what type of rule is needed (without writing the rule). Rank by materiality. Never invent data. Output as CoverageReport envelope.",
          "temperature": 0.1
        },
        "promptType": "define",
        "text": "=Trigger Type: {{ $('Webhook Trigger').item.json.body.triggerType }}\nTarget Pair: {{ $('Webhook Trigger').item.json.body.pair }}\nReported Fallback Rate: {{ $('Webhook Trigger').item.json.body.fallbackRate }}%\nBaseline Rate: {{ $('Webhook Trigger').item.json.body.baselineRate }}%\n\nCoverage Matrix:\n{{ JSON.stringify($('Fetch Coverage Matrix').item.json) }}\n\nFallback Firing Rate Details:\n{{ JSON.stringify($('Fetch Fallback Rate').item.json) }}\n\nUncovered Pairs:\n{{ JSON.stringify($('Fetch Uncovered Pairs').item.json) }}\n\nGap Simulation ({{ $('Webhook Trigger').item.json.body.pair }}):\n{{ JSON.stringify($('Simulate Gap').item.json) }}\n\nAnalyze the coverage gaps and produce a CoverageReport with ranked risks and recommendations."
      },
      "id": "rule-cov-006",
      "name": "Gap Analyzer",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [1060, 320]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'SUCCESS', agentId: 'rule-coverage', pair: $('Webhook Trigger').item.json.body.pair, coverageReport: $json.output, correlationId: $('Webhook Trigger').item.json.body.correlationId, timestamp: new Date().toISOString() }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "rule-cov-007",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
