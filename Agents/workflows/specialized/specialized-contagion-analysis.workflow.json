      "name": "Calculate Blast Radius",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, 300]
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "You are a contagion analyst for an FX trade operations platform. Given: (1) affected trades, (2) affected books, (3) downstream aggregations, (4) shared dependencies, (5) blast radius metrics — produce a coherent impact narrative. Classify severity: CRITICAL (>1000 trades or >$1B notional), HIGH (>200 trades), MEDIUM (>50), LOW (≤50). Trace the contagion path from source to impact. Never invent entities. Output JSON: { \"severity\": \"\", \"tradeCount\": 0, \"notional\": 0, \"regions\": [], \"contagionPath\": [], \"sharedRisks\": [], \"narrative\": \"\" }.",
          "temperature": 0.1
        },
        "promptType": "define",
        "text": "=Contagion analysis for entity '{{ $('Webhook Trigger').item.json.body.entity }}' (type: {{ $('Webhook Trigger').item.json.body.entityType }}):\n\n- Trade dependencies: {{ JSON.stringify($('Find Trade Dependencies').item.json) }}\n- Affected books: {{ JSON.stringify($('Find Affected Books').item.json) }}\n- Downstream aggregations: {{ JSON.stringify($('Find Downstream Aggregations').item.json) }}\n- Shared market-data dependencies: {{ JSON.stringify($('Find Shared Dependencies').item.json) }}\n- Blast radius metrics: {{ JSON.stringify($('Calculate Blast Radius').item.json) }}\n\nProduce a contagion impact narrative with severity classification."
      },
      "id": "contagion-node-007",
      "name": "Impact Narrator",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ agent: 'contagion-analysis', entity: $('Webhook Trigger').item.json.body.entity, entityType: $('Webhook Trigger').item.json.body.entityType, correlationId: $('Webhook Trigger').item.json.body.correlationId, blastRadius: $('Calculate Blast Radius').item.json, impactNarrative: $json.output, timestamp: new Date().toISOString() }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "contagion-node-008",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1400, 300]
    }
