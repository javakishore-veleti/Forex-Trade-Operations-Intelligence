{
  "name": "Specialized — State Divergence Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "state-divergence",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "state-div-001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300],
      "webhookId": "state-divergence-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://state-reconciliation-service:8087/mcp/queryTradeState",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tradeId: $json.body.tradeId, correlationId: $json.body.correlationId }) }}",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-Correlation-Id", "value": "={{ $json.body.correlationId }}" }
          ]
        }
      },
      "id": "state-div-002",
      "name": "Query Postgres",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 100]
    },
    {
