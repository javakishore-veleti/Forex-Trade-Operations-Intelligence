// RULE_VERSION: RULES-7.14
package com.fxtradeops.riskcalc.rules;

import com.fxtradeops.riskcalc.domain.RiskFact;
import java.math.BigDecimal;
import java.math.RoundingMode;

// FX-PAIR-EURUSD-001: EUR/USD specific volatility rule
rule "FX-PAIR-EURUSD-001"
    when
        $fact : RiskFact( currencyPairCode == "EURUSD" )
    then
        BigDecimal notional = $fact.getNotionalAmount();
        BigDecimal volatility = notional.multiply(new BigDecimal("0.0250")).setScale(4, RoundingMode.HALF_UP);
        BigDecimal exposure = notional.multiply(new BigDecimal("0.0100")).setScale(4, RoundingMode.HALF_UP);
        BigDecimal regional = notional.multiply(new BigDecimal("0.0050")).setScale(4, RoundingMode.HALF_UP);
        BigDecimal risk = volatility.add(exposure).add(regional).setScale(4, RoundingMode.HALF_UP);
        $fact.setVolatilityFactor(volatility);
        $fact.setNotionalExposureFactor(exposure);
        $fact.setRegionalAdjustmentFactor(regional);
        $fact.setRiskAmount(risk);
        $fact.addRuleFired("FX-PAIR-EURUSD-001");
end

