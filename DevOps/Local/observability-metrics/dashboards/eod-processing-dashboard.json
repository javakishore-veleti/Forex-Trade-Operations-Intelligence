{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"eod-processing-service\"}[2m]))",
          "legendFormat": "Requests/s"
        }
      ]
    },
    {
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"eod-processing-service\",status=~\"5..\"}[2m])) / sum(rate(http_server_requests_seconds_count{service=\"eod-processing-service\"}[2m])) * 100",
          "legendFormat": "Error %"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "title": "Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{service=\"eod-processing-service\"}[2m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{service=\"eod-processing-service\"}[2m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{service=\"eod-processing-service\"}[2m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Region Close Status",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "eod_region_close_status",
          "legendFormat": "{{ region_code }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "IN_PROGRESS", "color": "blue" } }, "type": "value" },
            { "options": { "1": { "text": "READY", "color": "green" } }, "type": "value" },
            { "options": { "2": { "text": "BLOCKED", "color": "red" } }, "type": "value" },
            { "options": { "3": { "text": "CLOSED", "color": "dark-green" } }, "type": "value" }
          ]
        }
      }
    },
    {
      "title": "Branch Completion % by Region",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "eod_branch_completion_percentage",
          "legendFormat": "{{ region_code }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "title": "Time-to-Close by Region",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "eod_time_to_close_seconds",
          "legendFormat": "{{ region_code }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "JVM Heap Memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{service=\"eod-processing-service\",area=\"heap\"}",
          "legendFormat": "{{ id }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    }
  ],
  "schemaVersion": 39,
  "tags": ["fxops", "eod-processing-service"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "FX Operations - EOD Processing Service",
  "uid": "fxops-eod-processing",
  "version": 1
}
